---
interface Props {
  /** Score 0–5 (halves allowed). Usually your review's `rating` frontmatter. */
  value: number;
  class?: string;
}
const { value, class: className } = Astro.props;
const clamped = Math.max(0, Math.min(5, value));
const pct = (clamped / 5) * 100;
---

<div class:list={['rating-block', className]}>
  <span class="rating" role="img" aria-label={`${clamped} / 5`}>
    <span class="stars-bg" aria-hidden="true">★★★★★</span>
    <span class="stars-fg" style={`width:${pct}%`} aria-hidden="true">★★★★★</span>
  </span>
  <span class="value">
    {clamped.toFixed(1)}<span class="max"> / 5</span>
  </span>
</div>

<style>
  .rating-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin-block: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  /* Scale the shared star glyphs up (their size is driven by font-size). */
  .rating-block .rating {
    font-size: 2.75rem;
    line-height: 1;
  }
  .value {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text);
  }
  .max {
    font-weight: 600;
    color: var(--text-muted);
  }
</style>
