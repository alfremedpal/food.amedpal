---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

{/*
  Opens the Pagefind search modal. The Pagefind UI (~47 KB gz) is only loaded
  on first click, so it costs nothing on page load. The index under /pagefind/
  is generated after `astro build`, so search only works on the built site
  (`pnpm build && pnpm preview`), not in `pnpm dev`.
*/}
<button
  type="button"
  class="icon-button"
  aria-label={t('nav.search')}
  title={t('nav.search')}
  data-search-open
>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
    stroke="currentColor" stroke-width="2" stroke-linecap="round"
    stroke-linejoin="round" aria-hidden="true">
    <circle cx="11" cy="11" r="7"></circle>
    <path d="M21 21l-4.3-4.3"></path>
  </svg>
</button>

<script is:inline>
  (() => {
    let modal;
    let loading;
    // Append a tag and resolve once it has loaded (CSS too, so the modal
    // never opens unstyled).
    const add = (el) =>
      new Promise((resolve, reject) => {
        el.onload = resolve;
        el.onerror = reject;
        document.head.append(el);
      });
    const load = () => {
      if (loading) return loading;
      const css = Object.assign(document.createElement('link'), {
        rel: 'stylesheet',
        href: '/pagefind/pagefind-component-ui.css',
      });
      const js = Object.assign(document.createElement('script'), {
        type: 'module',
        src: '/pagefind/pagefind-component-ui.js',
      });
      loading = Promise.all([add(css), add(js)]).catch((err) => {
        // Clean up so a later click can retry from scratch.
        css.remove();
        js.remove();
        loading = undefined;
        throw err;
      });
      return loading;
    };

    document.querySelectorAll('[data-search-open]').forEach((btn) =>
      btn.addEventListener('click', async () => {
        try {
          await load();
        } catch {
          return;
        }
        if (!modal) {
          // An empty <pagefind-modal> renders its default input + results.
          modal = document.createElement('pagefind-modal');
          document.body.append(modal);
        }
        modal.open();
      }),
    );
  })();
</script>

<style is:global>
  /* Pagefind components reset inherited styles; theme them via --pf-*
     mapped to the site tokens, so light/dark follows the site theme. Set on
     the element (not :root) so Pagefind's own :root defaults don't win. */
  pagefind-modal {
    --pf-font: var(--font-sans);
    --pf-text: var(--text);
    --pf-text-secondary: var(--text-muted);
    --pf-text-muted: var(--text-muted);
    --pf-background: var(--bg-elevated);
    --pf-border: var(--border);
    --pf-border-focus: var(--accent);
    --pf-outline-focus: var(--accent);
    --pf-hover: var(--bg);
    --pf-mark: var(--accent);
    --pf-border-radius: var(--radius);
  }
</style>
