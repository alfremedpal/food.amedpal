---
interface Props {
  /** Image URLs to display, in order. */
  images: string[];
  /**
   * Alt text applied to every slide. Optional; leave empty for purely
   * decorative galleries.
   */
  alt?: string;
}
const { images = [], alt = '' } = Astro.props;
const count = images.length;
---

{
  count > 0 && (
    <div class="carousel" data-count={count}>
      <div
        class="track"
        tabindex="0"
        role="group"
        aria-roledescription="carousel"
        aria-label={alt || 'Image gallery'}
      >
        {images.map((src, i) => (
          <figure class="slide">
            <img
              src={src}
              alt={alt}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
              draggable="false"
            />
          </figure>
        ))}
      </div>

      {count > 1 && (
        <>
          <button class="nav prev" type="button" aria-label="Previous image">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
              stroke-linejoin="round" aria-hidden="true">
              <path d="m15 18-6-6 6-6" />
            </svg>
          </button>
          <button class="nav next" type="button" aria-label="Next image">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
              stroke-linejoin="round" aria-hidden="true">
              <path d="m9 18 6-6-6-6" />
            </svg>
          </button>

          <div class="dots">
            {images.map((_, i) => (
              <button
                class="dot"
                type="button"
                data-index={i}
                aria-label={`Go to image ${i + 1}`}
                aria-current={i === 0 ? 'true' : 'false'}
              />
            ))}
          </div>
        </>
      )}
    </div>
  )
}

<style>
  .carousel {
    position: relative;
    width: 100%;
    margin-block: 1.75rem;
  }

  .track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    border-radius: var(--radius);
    /* Hide the scrollbar; navigation is via swipe / arrows / dots. */
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .track:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
    margin: 0;
    aspect-ratio: 16 / 9;
  }
  .slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Override the rounded/margined prose <img> defaults inside the track. */
    margin: 0;
    border-radius: 0;
    user-select: none;
  }

  .nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: none;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg-elevated) 82%, transparent);
    color: var(--text);
    cursor: pointer;
    box-shadow: var(--card-shadow);
    backdrop-filter: blur(4px);
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  .nav:hover {
    color: var(--accent);
    background: var(--bg-elevated);
  }
  .prev {
    left: 0.6rem;
  }
  .next {
    right: 0.6rem;
  }

  .dots {
    display: flex;
    justify-content: center;
    gap: 0.45rem;
    margin-top: 0.8rem;
  }
  .dot {
    width: 0.55rem;
    height: 0.55rem;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: var(--border);
    cursor: pointer;
    transition: background-color 0.15s ease, transform 0.15s ease;
  }
  .dot:hover {
    background: var(--text-muted);
  }
  .dot[aria-current='true'] {
    background: var(--accent);
    transform: scale(1.3);
  }

  /* On touch/coarse pointers, lean on swiping and free up the photo. */
  @media (hover: none) {
    .nav {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('.carousel').forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>('.track');
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.slide'));
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('.dot'));
    const prev = carousel.querySelector<HTMLButtonElement>('.prev');
    const next = carousel.querySelector<HTMLButtonElement>('.next');
    if (!track || slides.length < 2) return;

    let current = 0;

    const setActive = (index: number) => {
      current = index;
      dots.forEach((dot, i) =>
        dot.setAttribute('aria-current', i === index ? 'true' : 'false'),
      );
    };

    // Wrap around: past the last slide returns to the first, and vice versa.
    const goTo = (index: number) => {
      const wrapped = (index + slides.length) % slides.length;
      track.scrollTo({
        left: track.clientWidth * wrapped,
        behavior: reduceMotion ? 'auto' : 'smooth',
      });
      setActive(wrapped);
    };

    prev?.addEventListener('click', () => goTo(current - 1));
    next?.addEventListener('click', () => goTo(current + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

    // Keyboard support when the track is focused.
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        goTo(current - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        goTo(current + 1);
      }
    });

    // Keep the active dot in sync while the user swipes/scrolls manually.
    let raf = 0;
    track.addEventListener('scroll', () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        const index = Math.round(track.scrollLeft / track.clientWidth);
        if (index !== current) setActive(index);
      });
    });
  });
</script>
