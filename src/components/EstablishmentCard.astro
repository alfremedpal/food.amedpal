---
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { localizedPath, routeSegment } from '../i18n/utils';
import { establishmentSlug, type Establishment } from '../lib/establishments';
import Rating from './Rating.astro';
import HeroPlaceholder from './HeroPlaceholder.astro';

interface Props {
  establishment: Establishment;
  lang: Lang;
  /** How many dishes are reviewed here, shown as a small count. */
  dishCount?: number;
}
const { establishment, lang, dishCount } = Astro.props;
const href = localizedPath(
  lang,
  `${routeSegment(lang, 'places')}/${establishmentSlug(establishment)}`,
);
const { title, description, tags, heroImage, rating, location } =
  establishment.data;
---

<article class="card">
  <a class="cover" href={href}>
    {
      heroImage ? (
        <Image src={heroImage} alt={title} width={640} height={400} />
      ) : (
        <HeroPlaceholder title={title} />
      )
    }
    <span class="badge"><Rating value={rating} /></span>
  </a>
  <div class="body">
    <h3><a href={href}>{title}</a></h3>
    {location && <p class="where">{location}</p>}
    <p class="desc">{description}</p>
    <div class="foot">
      {
        typeof dishCount === 'number' && (
          <div class="meta">
            <span>🍽️ {dishCount}</span>
          </div>
        )
      }
      {
        tags.length > 0 && (
          <div class="tags">
            {tags.slice(0, 3).map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )
      }
    </div>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--card-shadow);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .card:hover {
    transform: translateY(-2px);
  }
  .cover {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
    display: block;
  }
  .badge {
    position: absolute;
    left: 0.6rem;
    bottom: 0.6rem;
    padding: 0.3rem 0.55rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(4px);
    border: 1px solid var(--border);
  }
  /* Fill the card so the footer (dish count + tags) can pin to the bottom and
     line up across cards of differing title/description length. */
  .body {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    padding: 1rem 1.1rem 1.2rem;
  }
  h3 {
    margin: 0 0 0.2rem;
    font-size: 1.2rem;
    line-height: 1.3;
    /* Clamp to two lines so a long name can't push the rest out of line. */
    min-height: 2.6em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  h3 a {
    color: var(--text);
    text-decoration: none;
  }
  h3 a:hover {
    color: var(--accent);
  }
  .where {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
  }
  .desc {
    margin: 0 0 0.75rem;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.5;
    /* Reserve a uniform three lines and ellipsize anything longer. */
    min-height: 4.5em;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* Everything above is free to vary in height; the footer is pushed to the
     bottom so the dish-count and tag rows sit at the same offset on every card. */
  .foot {
    margin-top: auto;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-muted);
    font-size: 0.85rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }
</style>
