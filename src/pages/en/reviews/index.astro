---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ReviewCard from '../../../components/ReviewCard.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { getReviews, reviewSlug } from '../../../lib/reviews';
import { useTranslations, localizedPath, routeSegment } from '../../../i18n/utils';
import {
  breadcrumbSchema,
  collectionPageSchema,
  jsonLdGraph,
  type Crumb,
} from '../../../lib/schema';

const lang = 'en' as const;
const t = useTranslations(lang);
const reviews = await getReviews(lang);
const alternates = { es: '/resenas/', en: '/en/reviews/' };

const crumbs: Crumb[] = [
  { name: t('breadcrumb.home'), path: localizedPath(lang) },
  { name: t('nav.reviews'), path: Astro.url.pathname },
];
const schema = jsonLdGraph([
  collectionPageSchema(Astro.site, {
    name: t('reviews.title'),
    url: new URL(Astro.url.pathname, Astro.site).href,
    lang,
    entries: reviews.map((review) => ({
      name: review.data.title,
      path: localizedPath(lang, `${routeSegment(lang, 'reviews')}/${reviewSlug(review)}`),
    })),
  }),
  breadcrumbSchema(Astro.site, crumbs),
]);
---

<BaseLayout lang={lang} title={t('reviews.title')} alternates={alternates} schema={schema}>
  <Breadcrumbs crumbs={crumbs} label={t('breadcrumb.label')} />
  <h1 class="page-title">{t('reviews.title')}</h1>
  {
    reviews.length === 0 ? (
      <p class="empty">{t('reviews.empty')}</p>
    ) : (
      <div class="grid">
        {reviews.map((review) => (
          <ReviewCard review={review} lang={lang} />
        ))}
      </div>
    )
  }
</BaseLayout>

<style>
  .page-title {
    padding-block: 0 1.5rem;
    font-size: clamp(2rem, 5vw, 2.6rem);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .empty {
    color: var(--text-muted);
  }
</style>
