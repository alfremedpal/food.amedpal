---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EstablishmentCard from '../../../components/EstablishmentCard.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import {
  getEstablishments,
  getReviewsForEstablishment,
  establishmentSlug,
} from '../../../lib/establishments';
import { useTranslations, localizedPath, routeSegment } from '../../../i18n/utils';
import {
  breadcrumbSchema,
  collectionPageSchema,
  jsonLdGraph,
  type Crumb,
} from '../../../lib/schema';

const lang = 'en' as const;
const t = useTranslations(lang);
const establishments = await getEstablishments(lang);
const counts = await Promise.all(
  establishments.map(async (e) => (await getReviewsForEstablishment(e)).length),
);
const alternates = { es: '/lugares/', en: '/en/places/' };

const crumbs: Crumb[] = [
  { name: t('breadcrumb.home'), path: localizedPath(lang) },
  { name: t('nav.places'), path: Astro.url.pathname },
];
const schema = jsonLdGraph([
  collectionPageSchema(Astro.site, {
    name: t('places.title'),
    url: new URL(Astro.url.pathname, Astro.site).href,
    lang,
    entries: establishments.map((establishment) => ({
      name: establishment.data.title,
      path: localizedPath(lang, `${routeSegment(lang, 'places')}/${establishmentSlug(establishment)}`),
    })),
  }),
  breadcrumbSchema(Astro.site, crumbs),
]);
---

<BaseLayout lang={lang} title={t('places.title')} alternates={alternates} schema={schema}>
  <Breadcrumbs crumbs={crumbs} label={t('breadcrumb.label')} />
  <h1 class="page-title">{t('places.title')}</h1>
  {
    establishments.length === 0 ? (
      <p class="empty">{t('places.empty')}</p>
    ) : (
      <div class="grid">
        {establishments.map((establishment, i) => (
          <EstablishmentCard
            establishment={establishment}
            lang={lang}
            dishCount={counts[i]}
          />
        ))}
      </div>
    )
  }
</BaseLayout>

<style>
  .page-title {
    padding-block: 0 1.5rem;
    font-size: clamp(2rem, 5vw, 2.6rem);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .empty {
    color: var(--text-muted);
  }
</style>
