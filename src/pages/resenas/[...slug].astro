---
import { render } from 'astro:content';
import ReviewLayout from '../../layouts/ReviewLayout.astro';
import { getReviews, reviewSlug } from '../../lib/reviews';
import { localizedPath, routeSegment } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

export async function getStaticPaths() {
  const es = await getReviews('es');
  const en = await getReviews('en');

  return es.map((review) => {
    const alternates: Partial<Record<Lang, string>> = {
      es: localizedPath('es', `${routeSegment('es', 'reviews')}/${reviewSlug(review)}`),
    };
    const key = review.data.translationKey;
    if (key) {
      const match = en.find((e) => e.data.translationKey === key);
      if (match) {
        alternates.en = localizedPath(
          'en',
          `${routeSegment('en', 'reviews')}/${reviewSlug(match)}`,
        );
      }
    }
    return {
      params: { slug: reviewSlug(review) },
      props: { review, alternates },
    };
  });
}

const { review, alternates } = Astro.props;
const { Content } = await render(review);
---

<ReviewLayout review={review} lang="es" alternates={alternates}>
  <Content />
</ReviewLayout>
