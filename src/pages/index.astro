---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReviewCard from '../components/ReviewCard.astro';
import AnnouncementList from '../components/AnnouncementList.astro';
import { getReviews } from '../lib/reviews';
import { getAnnouncements } from '../lib/announcements';
import { useTranslations } from '../i18n/utils';

const lang = 'es' as const;
const t = useTranslations(lang);
const reviews = (await getReviews(lang)).slice(0, 6);
const announcements = (await getAnnouncements(lang)).slice(0, 4);
const alternates = { es: '/', en: '/en/' };
---

<BaseLayout lang={lang} alternates={alternates}>
  <section class="hero">
    <h1>{t('site.title')}</h1>
    <p class="intro">{t('home.intro')}</p>
  </section>

  <section>
    <h2>{t('home.latest')}</h2>
    {
      reviews.length === 0 ? (
        <p class="empty">{t('reviews.empty')}</p>
      ) : (
        <div class="grid">
          {reviews.map((review) => (
            <ReviewCard review={review} lang={lang} />
          ))}
        </div>
      )
    }
  </section>

  {
    announcements.length > 0 && (
      <section>
        <h2>{t('home.announcements')}</h2>
        <AnnouncementList announcements={announcements} lang={lang} />
      </section>
    )
  }
</BaseLayout>

<style>
  .hero {
    padding-block: 3rem 1rem;
    max-width: var(--content-width);
  }
  .hero h1 {
    font-size: clamp(2.2rem, 6vw, 3.2rem);
    margin: 0 0 0.75rem;
  }
  .intro {
    font-size: 1.2rem;
    color: var(--text-muted);
  }
  h2 {
    margin: 2rem 0 1.25rem;
    font-size: 1.6rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .empty {
    color: var(--text-muted);
  }
</style>
