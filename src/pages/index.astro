---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReviewCard from '../components/ReviewCard.astro';
import EstablishmentCard from '../components/EstablishmentCard.astro';
import AnnouncementList from '../components/AnnouncementList.astro';
import { getReviews } from '../lib/reviews';
import {
  getEstablishments,
  getReviewsForEstablishment,
} from '../lib/establishments';
import { getAnnouncements } from '../lib/announcements';
import { useTranslations } from '../i18n/utils';

const lang = 'es' as const;
const t = useTranslations(lang);
const reviews = (await getReviews(lang)).slice(0, 6);
const establishments = (await getEstablishments(lang)).slice(0, 6);
const dishCounts = await Promise.all(
  establishments.map(async (e) => (await getReviewsForEstablishment(e)).length),
);
const announcements = (await getAnnouncements(lang)).slice(0, 4);
const alternates = { es: '/', en: '/en/' };
---

<BaseLayout lang={lang} alternates={alternates}>
  <section class="hero">
    <h1>{t('site.title')}</h1>
    <p class="intro">{t('home.intro')}</p>
  </section>

  <section>
    <h2>{t('home.latest')}</h2>

    <h3 class="subhead">{t('home.dishes')}</h3>
    {
      reviews.length === 0 ? (
        <p class="empty">{t('reviews.empty')}</p>
      ) : (
        <div class="grid">
          {reviews.map((review) => (
            <ReviewCard review={review} lang={lang} />
          ))}
        </div>
      )
    }

    <h3 class="subhead">{t('home.places')}</h3>
    {
      establishments.length === 0 ? (
        <p class="empty">{t('places.empty')}</p>
      ) : (
        <div class="grid">
          {establishments.map((establishment, i) => (
            <EstablishmentCard
              establishment={establishment}
              lang={lang}
              dishCount={dishCounts[i]}
            />
          ))}
        </div>
      )
    }
  </section>

  {
    announcements.length > 0 && (
      <section>
        <h2>{t('home.announcements')}</h2>
        <AnnouncementList announcements={announcements} lang={lang} />
      </section>
    )
  }
</BaseLayout>

<style>
  .hero {
    padding-block: 3rem 1rem;
    max-width: var(--content-width);
  }
  .hero h1 {
    font-size: clamp(2.2rem, 6vw, 3.2rem);
    margin: 0 0 0.75rem;
  }
  .intro {
    font-size: 1.2rem;
    color: var(--text-muted);
  }
  h2 {
    margin: 2rem 0 1.25rem;
    font-size: 1.6rem;
  }
  .subhead {
    margin: 2rem 0 1rem;
    font-size: 1.15rem;
    color: var(--text-muted);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .empty {
    color: var(--text-muted);
  }

  /* On mobile the reviews become a swipeable, snapping carousel that
     bleeds to the screen edges. Desktop keeps the grid above. */
  @media (max-width: 640px) {
    .grid {
      display: flex;
      grid-template-columns: none;
      gap: 1rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      /* extend past the container's 1.25rem gutter, then pad it back */
      margin-inline: -1.25rem;
      padding-inline: 1.25rem;
      scroll-padding-inline: 1.25rem;
      scrollbar-width: none;
    }
    .grid::-webkit-scrollbar {
      display: none;
    }
    .grid > :global(.card) {
      flex: 0 0 82%;
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }
  }
</style>
