---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import type { Lang } from '../i18n/ui';
import { useTranslations, formatDate, localizedPath } from '../i18n/utils';
import type { Announcement } from '../lib/announcements';

interface Props {
  announcement: Announcement;
  lang: Lang;
  alternates: Partial<Record<Lang, string>>;
}
const { announcement, lang, alternates } = Astro.props;
const t = useTranslations(lang);
const { title, description, pubDate, updatedDate, heroImage } =
  announcement.data;
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  alternates={alternates}
>
  <article class="announcement">
    <a class="back" href={localizedPath(lang)}>{t('announcement.back')}</a>

    <header class="head">
      <span class="badge">📣</span>
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      <div class="meta">
        <time datetime={pubDate.toISOString()}>
          {t('announcement.published')} {formatDate(pubDate, lang)}
        </time>
        {
          updatedDate && (
            <>
              <span class="dot">·</span>
              <time datetime={updatedDate.toISOString()} class="updated">
                {t('review.updated')} {formatDate(updatedDate, lang)}
              </time>
            </>
          )
        }
      </div>
    </header>

    {
      heroImage && (
        <Image
          class="hero"
          src={heroImage}
          alt={title}
          width={1080}
          height={620}
        />
      )
    }

    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .announcement {
    padding-block: 2rem;
  }
  .back {
    display: inline-block;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--text-muted);
  }
  .back:hover {
    color: var(--accent);
  }
  .badge {
    font-size: 1.5rem;
  }
  .head h1 {
    margin: 0.25rem 0 0.5rem;
    font-size: clamp(2rem, 5vw, 2.8rem);
  }
  .lead {
    margin: 0 0 1rem;
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: var(--content-width);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .updated {
    font-style: italic;
  }
  .hero {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin-block: 1.75rem;
  }
</style>
