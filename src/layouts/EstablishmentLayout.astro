---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Rating from '../components/Rating.astro';
import ReviewCard from '../components/ReviewCard.astro';
import type { Lang } from '../i18n/ui';
import { useTranslations, formatDate, localizedPath, routeSegment } from '../i18n/utils';
import type { Establishment } from '../lib/establishments';
import type { Review } from '../lib/reviews';

interface Props {
  establishment: Establishment;
  dishes: Review[];
  lang: Lang;
  alternates: Partial<Record<Lang, string>>;
}
const { establishment, dishes, lang, alternates } = Astro.props;
const t = useTranslations(lang);
const {
  title,
  description,
  pubDate,
  updatedDate,
  tags,
  heroImage,
  rating,
  location,
} = establishment.data;
const placesHref = localizedPath(lang, routeSegment(lang, 'places'));
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  alternates={alternates}
>
  <article class="place">
    <a class="back" href={placesHref}>{t('place.back')}</a>

    <header class="head">
      <h1>{title}</h1>
      {location && <p class="where">{location}</p>}
      <div class="score">
        <span class="score-label">{t('place.rating')}</span>
        <Rating value={rating} />
      </div>
      <p class="lead">{description}</p>
      <div class="meta">
        <time datetime={pubDate.toISOString()}>
          {t('review.published')} {formatDate(pubDate, lang)}
        </time>
        {
          updatedDate && (
            <>
              <span class="dot">·</span>
              <time datetime={updatedDate.toISOString()} class="updated">
                {t('review.updated')} {formatDate(updatedDate, lang)}
              </time>
            </>
          )
        }
      </div>
      {
        tags.length > 0 && (
          <div class="tags">
            {tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )
      }
    </header>

    {
      heroImage && (
        <Image
          class="hero"
          src={heroImage}
          alt={title}
          width={1080}
          height={620}
          loading="eager"
          decoding="sync"
          fetchpriority="high"
        />
      )
    }

    <div class="prose">
      <slot />
    </div>

    <section class="dishes">
      <h2>{t('place.dishes')}</h2>
      {
        dishes.length === 0 ? (
          <p class="empty">{t('place.dishes.empty')}</p>
        ) : (
          <div class="grid">
            {dishes.map((review) => (
              <ReviewCard review={review} lang={lang} />
            ))}
          </div>
        )
      }
    </section>
  </article>
</BaseLayout>

<style>
  .place {
    max-width: var(--content-width);
    margin-inline: auto;
    padding-block: 2rem;
  }
  .back {
    display: inline-block;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--text-muted);
  }
  .back:hover {
    color: var(--accent);
  }
  .head {
    max-width: var(--content-width);
  }
  .head h1 {
    margin: 0 0 0.35rem;
    font-size: clamp(2rem, 5vw, 2.8rem);
  }
  .where {
    margin: 0 0 0.6rem;
    font-weight: 600;
    color: var(--accent);
  }
  .score {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.3rem;
    margin-bottom: 1rem;
  }
  .score-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
  }
  .lead {
    margin: 0 0 1rem;
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: var(--content-width);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .updated {
    font-style: italic;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }
  .hero {
    width: 100%;
    max-width: var(--content-width);
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin-block: 1.75rem;
  }
  .dishes {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .dishes h2 {
    margin: 0 0 1.25rem;
    font-size: 1.6rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .empty {
    color: var(--text-muted);
  }
</style>
