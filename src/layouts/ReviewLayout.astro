---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Rating from '../components/Rating.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import type { Lang } from '../i18n/ui';
import { useTranslations, formatDate, localizedPath, routeSegment } from '../i18n/utils';
import type { Review } from '../lib/reviews';
import { establishmentSlug } from '../lib/establishments';
import {
  absUrl,
  breadcrumbSchema,
  jsonLdGraph,
  reviewSchema,
  type Crumb,
} from '../lib/schema';

interface Props {
  review: Review;
  lang: Lang;
  alternates: Partial<Record<Lang, string>>;
}
const { review, lang, alternates } = Astro.props;
const t = useTranslations(lang);
const {
  title,
  description,
  pubDate,
  updatedDate,
  tags,
  heroImage,
  rating,
  place,
  location,
} = review.data;
const reviewsHref = localizedPath(lang, routeSegment(lang, 'reviews'));

// If the dish belongs to a tracked establishment, link up to its page and use
// its name; otherwise fall back to the free-text `place`.
const establishment = review.data.establishment
  ? await getEntry(review.data.establishment)
  : undefined;
// Only link to the establishment when its page actually exists — drafts are not
// built in production, so linking to one would 404.
const establishmentLinkable =
  establishment && (import.meta.env.PROD ? !establishment.data.draft : true);
const establishmentHref = establishmentLinkable
  ? localizedPath(lang, `${routeSegment(lang, 'places')}/${establishmentSlug(establishment)}`)
  : undefined;
const placeName = establishment?.data.title ?? place;
const where = [placeName, location].filter(Boolean).join(' · ');

// Breadcrumbs mirror the topical hierarchy, not the flat URL: when the dish
// belongs to a tracked place, the trail runs Home → Places → <place> → <dish>;
// otherwise it falls back to Home → Reviews → <dish>.
const crumbs: Crumb[] = establishmentHref
  ? [
      { name: t('breadcrumb.home'), path: localizedPath(lang) },
      { name: t('nav.places'), path: localizedPath(lang, routeSegment(lang, 'places')) },
      { name: placeName!, path: establishmentHref },
      { name: title, path: Astro.url.pathname },
    ]
  : [
      { name: t('breadcrumb.home'), path: localizedPath(lang) },
      { name: t('nav.reviews'), path: reviewsHref },
      { name: title, path: Astro.url.pathname },
    ];

const schema = jsonLdGraph([
  reviewSchema({
    title,
    description,
    pubDate,
    updatedDate,
    rating,
    placeName,
    location,
    placeUrl: establishmentHref ? absUrl(Astro.site, establishmentHref) : undefined,
    image: heroImage,
  }),
  breadcrumbSchema(Astro.site, crumbs),
]);
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  alternates={alternates}
  schema={schema}
>
  <article class="review">
    <Breadcrumbs crumbs={crumbs} label={t('breadcrumb.label')} />

    <header class="head">
      <h1>{title}</h1>
      {
        establishmentHref ? (
          <p class="where">
            <a href={establishmentHref}>{placeName}</a>
            {location && <span class="where-loc"> · {location}</span>}
          </p>
        ) : (
          where && <p class="where">{where}</p>
        )
      }
      <div class="score">
        <Rating value={rating} />
      </div>
      <p class="lead">{description}</p>
      <div class="meta">
        <time datetime={pubDate.toISOString()}>
          {t('review.published')} {formatDate(pubDate, lang)}
        </time>
        {
          updatedDate && (
            <>
              <span class="dot">·</span>
              <time datetime={updatedDate.toISOString()} class="updated">
                {t('review.updated')} {formatDate(updatedDate, lang)}
              </time>
            </>
          )
        }
      </div>
      {
        tags.length > 0 && (
          <div class="tags">
            {tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )
      }
    </header>

    {
      heroImage && (
        <Image
          class="hero"
          src={heroImage}
          alt={title}
          width={1080}
          height={620}
          loading="eager"
          decoding="sync"
          fetchpriority="high"
        />
      )
    }

    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .review {
    max-width: var(--content-width);
    margin-inline: auto;
    padding-block: 0.5rem 2rem;
  }
  .head {
    max-width: var(--content-width);
  }
  .head h1 {
    margin: 0 0 0.35rem;
    font-size: clamp(2rem, 5vw, 2.8rem);
  }
  .where {
    margin: 0 0 0.6rem;
    font-weight: 600;
    color: var(--accent);
  }
  .where a {
    color: inherit;
    text-decoration: none;
  }
  .where a:hover {
    text-decoration: underline;
  }
  .where-loc {
    color: var(--text-muted);
  }
  .score {
    font-size: 1.3rem;
    margin-bottom: 1rem;
  }
  .lead {
    margin: 0 0 1rem;
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: var(--content-width);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .updated {
    font-style: italic;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }
  .hero {
    width: 100%;
    max-width: var(--content-width);
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin-block: 1.75rem;
  }
</style>
