---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Rating from '../components/Rating.astro';
import type { Lang } from '../i18n/ui';
import { useTranslations, formatDate, localizedPath, routeSegment } from '../i18n/utils';
import type { Review } from '../lib/reviews';

interface Props {
  review: Review;
  lang: Lang;
  alternates: Partial<Record<Lang, string>>;
}
const { review, lang, alternates } = Astro.props;
const t = useTranslations(lang);
const {
  title,
  description,
  pubDate,
  updatedDate,
  tags,
  heroImage,
  rating,
  place,
  location,
} = review.data;
const reviewsHref = localizedPath(lang, routeSegment(lang, 'reviews'));
const where = [place, location].filter(Boolean).join(' · ');
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  alternates={alternates}
>
  <article class="review">
    <a class="back" href={reviewsHref}>{t('review.back')}</a>

    <header class="head">
      <h1>{title}</h1>
      {where && <p class="where">{where}</p>}
      <div class="score">
        <Rating value={rating} />
      </div>
      <p class="lead">{description}</p>
      <div class="meta">
        <time datetime={pubDate.toISOString()}>
          {t('review.published')} {formatDate(pubDate, lang)}
        </time>
        {
          updatedDate && (
            <>
              <span class="dot">·</span>
              <time datetime={updatedDate.toISOString()} class="updated">
                {t('review.updated')} {formatDate(updatedDate, lang)}
              </time>
            </>
          )
        }
      </div>
      {
        tags.length > 0 && (
          <div class="tags">
            {tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )
      }
    </header>

    {
      heroImage && (
        <Image
          class="hero"
          src={heroImage}
          alt={title}
          width={1080}
          height={620}
          loading="eager"
          decoding="sync"
          fetchpriority="high"
        />
      )
    }

    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .review {
    max-width: var(--content-width);
    margin-inline: auto;
    padding-block: 2rem;
  }
  .back {
    display: inline-block;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--text-muted);
  }
  .back:hover {
    color: var(--accent);
  }
  .head {
    max-width: var(--content-width);
  }
  .head h1 {
    margin: 0 0 0.35rem;
    font-size: clamp(2rem, 5vw, 2.8rem);
  }
  .where {
    margin: 0 0 0.6rem;
    font-weight: 600;
    color: var(--accent);
  }
  .score {
    font-size: 1.3rem;
    margin-bottom: 1rem;
  }
  .lead {
    margin: 0 0 1rem;
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: var(--content-width);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .updated {
    font-style: italic;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }
  .hero {
    width: 100%;
    max-width: var(--content-width);
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin-block: 1.75rem;
  }
</style>
